es the core Git helper functions, policy guards, and branch, diff, show flows.\\\",\\\"confidence\\\":\\\"high\\\"},{\\\"id\\\":\\\"auth-007\\\",\\\"kind\\\":\\\"doc\\\",\\\"path\\\":\\\"README.md\\\",\\\"citations\\\":[\\\"README.md:5-97@4503e2d12b79\\\",\\\"README.md:120-183@4503e2d12b79\\\"],\\\"authority_source\\\":\\\"doc\\\",\\\"claim_register\\\":\\\"interpretive\\\",\\\"claim_status\\\":\\\"active\\\",\\\"evidence_kinds\\\":[\\\"static_structure\\\"],\\\"corroboration_count\\\":2,\\\"rationale\\\":\\\"Documents the published tool surface and supported launch and configuration patterns.\\\",\\\"confidence\\\":\\\"medium\\\"}],\\\"edges\\\":[{\\\"id\\\":\\\"edge-0001\\\",\\\"kind\\\":\\\"import\\\",\\\"from\\\":{\\\"path\\\":\\\"src/mcp_server_git/__main__.py\\\",\\\"symbol\\\":\\\"module\\\"},\\\"to\\\":{\\\"path\\\":\\\"src/mcp_server_git/__init__.py\\\",\\\"symbol\\\":\\\"main\\\"},\\\"citations\\\":[\\\"src/mcp_server_git/__main__.py:1-4@4503e2d12b79\\\"],\\\"extractor_id\\\":\\\"ext-python-imports-v1\\\",\\\"claim_register\\\":\\\"factual\\\",\\\"claim_status\\\":\\\"active\\\",\\\"evidence_kinds\\\":[\\\"static_relation\\\"],\\\"corroboration_count\\\":1,\\\"confidence\\\":\\\"high\\\"},{\\\"id\\\":\\\"edge-0002\\\",\\\"kind\\\":\\\"call\\\",\\\"from\\\":{\\\"path\\\":\\\"src/mcp_server_git/__main__.py\\\",\\\"symbol\\\":\\\"main\\\"},\\\"to\\\":{\\\"path\\\":\\\"src/mcp_server_git/__init__.py\\\",\\\"symbol\\\":\\\"main\\\"},\\\"citations\\\":[\\\"src/mcp_server_git/__main__.py:1-4@4503e2d12b79\\\"],\\\"extractor_id\\\":\\\"ext-python-calls-v1\\\",\\\"claim_register\\\":\\\"factual\\\",\\\"claim_status\\\":\\\"active\\\",\\\"evidence_kinds\\\":[\\\"static_relation\\\"],\\\"corroboration_count\\\":1,\\\"confidence\\\":\\\"high\\\"},{\\\"id\\\":\\\"edge-0003\\\",\\\"kind\\\":\\\"call\\\",\\\"from\\\":{\\\"path\\\":\\\"src/mcp_server_git/__init__.py\\\",\\\"symbol\\\":\\\"main\\\"},\\\"to\\\":{\\\"path\\\":\\\"src/mcp_server_git/server.py\\\",\\\"symbol\\\