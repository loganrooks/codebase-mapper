{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba pyproject.toml'","aggregated_output":"     1\t[project]\n     2\tname = \"mcp-server-git\"\n     3\tversion = \"0.6.2\"\n     4\tdescription = \"A Model Context Protocol server providing tools to read, search, and manipulate Git repositories programmatically via LLMs\"\n     5\treadme = \"README.md\"\n     6\trequires-python = \">=3.10\"\n     7\tauthors = [{ name = \"Anthropic, PBC.\" }]\n     8\tmaintainers = [{ name = \"David Soria Parra\", email = \"davidsp@anthropic.com\" }]\n     9\tkeywords = [\"git\", \"mcp\", \"llm\", \"automation\"]\n    10\tlicense = { text = \"MIT\" }\n    11\tclassifiers = [\n    12\t    \"Development Status :: 4 - Beta\",\n    13\t    \"Intended Audience :: Developers\",\n    14\t    \"License :: OSI Approved :: MIT License\",\n    15\t    \"Programming Language :: Python :: 3\",\n    16\t    \"Programming Language :: Python :: 3.10\",\n    17\t]\n    18\tdependencies = [\n    19\t    \"click>=8.1.7\",\n    20\t    \"gitpython>=3.1.45\",\n    21\t    \"mcp>=1.0.0\",\n    22\t    \"pydantic>=2.0.0\",\n    23\t]\n    24\t\n    25\t[project.scripts]\n    26\tmcp-server-git = \"mcp_server_git:main\"\n    27\t\n    28\t[build-system]\n    29\trequires = [\"hatchling\"]\n    30\tbuild-backend = \"hatchling.build\"\n    31\t\n    32\t[dependency-groups]\n    33\tdev = [\"pyright>=1.1.407\", \"ruff>=0.7.3\", \"pytest>=8.0.0\"]\n    34\t\n    35\t[tool.pytest.ini_options]\n    36\ttestpaths = [\"tests\"]\n    37\tpython_files = \"test_*.py\"\n    38\tpython_classes = \"Test*\"\n    39\tpython_functions = \"test_*\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba tests/test_server.py'","aggregated_output":"     1\timport pytest\n     2\tfrom pathlib import Path\n     3\timport git\n     4\tfrom git.exc import BadName\n     5\tfrom mcp_server_git.server import (\n     6\t    git_checkout,\n     7\t    git_branch,\n     8\t    git_add,\n     9\t    git_status,\n    10\t    git_diff_unstaged,\n    11\t    git_diff_staged,\n    12\t    git_diff,\n    13\t    git_commit,\n    14\t    git_reset,\n    15\t    git_log,\n    16\t    git_create_branch,\n    17\t    git_show,\n    18\t    validate_repo_path,\n    19\t)\n    20\timport shutil\n    21\t\n    22\t@pytest.fixture\n    23\tdef test_repository(tmp_path: Path):\n    24\t    repo_path = tmp_path / \"temp_test_repo\"\n    25\t    test_repo = git.Repo.init(repo_path)\n    26\t\n    27\t    Path(repo_path / \"test.txt\").write_text(\"test\")\n    28\t    test_repo.index.add([\"test.txt\"])\n    29\t    test_repo.index.commit(\"initial commit\")\n    30\t\n    31\t    yield test_repo\n    32\t\n    33\t    shutil.rmtree(repo_path)\n    34\t\n    35\tdef test_git_checkout_existing_branch(test_repository):\n    36\t    test_repository.git.branch(\"test-branch\")\n    37\t    result = git_checkout(test_repository, \"test-branch\")\n    38\t\n    39\t    assert \"Switched to branch 'test-branch'\" in result\n    40\t    assert test_repository.active_branch.name == \"test-branch\"\n    41\t\n    42\tdef test_git_checkout_nonexistent_branch(test_repository):\n    43\t\n    44\t    with pytest.raises(BadName):\n    45\t        git_checkout(test_repository, \"nonexistent-branch\")\n    46\t\n    47\tdef test_git_branch_local(test_repository):\n    48\t    test_repository.git.branch(\"new-branch-local\")\n    49\t    result = git_branch(test_repository, \"local\")\n    50\t    assert \"new-branch-local\" in result\n    51\t\n    52\tdef test_git_branch_remote(test_repository):\n    53\t    result = git_branch(test_repository, \"remote\")\n    54\t    assert \"\" == result.strip()  # Should be empty if no remote branches\n    55\t\n    56\tdef test_git_branch_all(test_repository):\n    57\t    test_repository.git.branch(\"new-branch-all\")\n    58\t    result = git_branch(test_repository, \"all\")\n    59\t    assert \"new-branch-all\" in result\n    60\t\n    61\tdef test_git_branch_contains(test_repository):\n    62\t    # Get the default branch name (could be \"main\" or \"master\")\n    63\t    default_branch = test_repository.active_branch.name\n    64\t    # Create a new branch and commit to it\n    65\t    test_repository.git.checkout(\"-b\", \"feature-branch\")\n    66\t    Path(test_repository.working_dir / Path(\"feature.txt\")).write_text(\"feature content\")\n    67\t    test_repository.index.add([\"feature.txt\"])\n    68\t    commit = test_repository.index.commit(\"feature commit\")\n    69\t    test_repository.git.checkout(default_branch)\n    70\t\n    71\t    result = git_branch(test_repository, \"local\", contains=commit.hexsha)\n    72\t    assert \"feature-branch\" in result\n    73\t    assert default_branch not in result\n    74\t\n    75\tdef test_git_branch_not_contains(test_repository):\n    76\t    # Get the default branch name (could be \"main\" or \"master\")\n    77\t    default_branch = test_repository.active_branch.name\n    78\t    # Create a new branch and commit to it\n    79\t    test_repository.git.checkout(\"-b\", \"another-feature-branch\")\n    80\t    Path(test_repository.working_dir / Path(\"another_feature.txt\")).write_text(\"another feature content\")\n    81\t    test_repository.index.add([\"another_feature.txt\"])\n    82\t    commit = test_repository.index.commit(\"another feature commit\")\n    83\t    test_repository.git.checkout(default_branch)\n    84\t\n    85\t    result = git_branch(test_repository, \"local\", not_contains=commit.hexsha)\n    86\t    assert \"another-feature-branch\" not in result\n    87\t    assert default_branch in result\n    88\t\n    89\tdef test_git_add_all_files(test_repository):\n    90\t    file_path = Path(test_repository.working_dir) / \"all_file.txt\"\n    91\t    file_path.write_text(\"adding all\")\n    92\t\n    93\t    result = git_add(test_repository, [\".\"])\n    94\t\n    95\t    staged_files = [item.a_path for item in test_repository.index.diff(\"HEAD\")]\n    96\t    assert \"all_file.txt\" in staged_files\n    97\t    assert result == \"Files staged successfully\"\n    98\t\n    99\tdef test_git_add_specific_files(test_repository):\n   100\t    file1 = Path(test_repository.working_dir) / \"file1.txt\"\n   101\t    file2 = Path(test_repository.working_dir) / \"file2.txt\"\n   102\t    file1.write_text(\"file 1 content\")\n   103\t    file2.write_text(\"file 2 content\")\n   104\t\n   105\t    result = git_add(test_repository, [\"file1.txt\"])\n   106\t\n   107\t    staged_files = [item.a_path for item in test_repository.index.diff(\"HEAD\")]\n   108\t    assert \"file1.txt\" in staged_files\n   109\t    assert \"file2.txt\" not in staged_files\n   110\t    assert result == \"Files staged successfully\"\n   111\t\n   112\tdef test_git_status(test_repository):\n   113\t    result = git_status(test_repository)\n   114\t\n   115\t    assert result is not None\n   116\t    assert \"On branch\" in result or \"branch\" in result.lower()\n   117\t\n   118\tdef test_git_diff_unstaged(test_repository):\n   119\t    file_path = Path(test_repository.working_dir) / \"test.txt\"\n   120\t    file_path.write_text(\"modified content\")\n   121\t\n   122\t    result = git_diff_unstaged(test_repository)\n   123\t\n   124\t    assert \"test.txt\" in result\n   125\t    assert \"modified content\" in result\n   126\t\n   127\tdef test_git_diff_unstaged_empty(test_repository):\n   128\t    result = git_diff_unstaged(test_repository)\n   129\t\n   130\t    assert result == \"\"\n   131\t\n   132\tdef test_git_diff_staged(test_repository):\n   133\t    file_path = Path(test_repository.working_dir) / \"staged_file.txt\"\n   134\t    file_path.write_text(\"staged content\")\n   135\t    test_repository.index.add([\"staged_file.txt\"])\n   136\t\n   137\t    result = git_diff_staged(test_repository)\n   138\t\n   139\t    assert \"staged_file.txt\" in result\n   140\t    assert \"staged content\" in result\n   141\t\n   142\tdef test_git_diff_staged_empty(test_repository):\n   143\t    result = git_diff_staged(test_repository)\n   144\t\n   145\t    assert result == \"\"\n   146\t\n   147\tdef test_git_diff(test_repository):\n   148\t    # Get the default branch name (could be \"main\" or \"master\")\n   149\t    default_branch = test_repository.active_branch.name\n   150\t    test_repository.git.checkout(\"-b\", \"feature-diff\")\n   151\t    file_path = Path(test_repository.working_dir) / \"test.txt\"\n   152\t    file_path.write_text(\"feature changes\")\n   153\t    test_repository.index.add([\"test.txt\"])\n   154\t    test_repository.index.commit(\"feature commit\")\n   155\t\n   156\t    result = git_diff(test_repository, default_branch)\n   157\t\n   158\t    assert \"test.txt\" in result\n   159\t    assert \"feature changes\" in result\n   160\t\n   161\tdef test_git_commit(test_repository):\n   162\t    file_path = Path(test_repository.working_dir) / \"commit_test.txt\"\n   163\t    file_path.write_text(\"content to commit\")\n   164\t    test_repository.index.add([\"commit_test.txt\"])\n   165\t\n   166\t    result = git_commit(test_repository, \"test commit message\")\n   167\t\n   168\t    assert \"Changes committed successfully with hash\" in result\n   169\t\n   170\t    latest_commit = test_repository.head.commit\n   171\t    assert latest_commit.message.strip() == \"test commit message\"\n   172\t\n   173\tdef test_git_reset(test_repository):\n   174\t    file_path = Path(test_repository.working_dir) / \"reset_test.txt\"\n   175\t    file_path.write_text(\"content to reset\")\n   176\t    test_repository.index.add([\"reset_test.txt\"])\n   177\t\n   178\t    staged_before = [item.a_path for item in test_repository.index.diff(\"HEAD\")]\n   179\t    assert \"reset_test.txt\" in staged_before\n   180\t\n   181\t    result = git_reset(test_repository)\n   182\t\n   183\t    assert result == \"All staged changes reset\"\n   184\t\n   185\t    staged_after = [item.a_path for item in test_repository.index.diff(\"HEAD\")]\n   186\t    assert \"reset_test.txt\" not in staged_after\n   187\t\n   188\tdef test_git_log(test_repository):\n   189\t    for i in range(3):\n   190\t        file_path = Path(test_repository.working_dir) / f\"log_test_{i}.txt\"\n   191\t        file_path.write_text(f\"content {i}\")\n   192\t        test_repository.index.add([f\"log_test_{i}.txt\"])\n   193\t        test_repository.index.commit(f\"commit {i}\")\n   194\t\n   195\t    result = git_log(test_repository, max_count=2)\n   196\t\n   197\t    assert isinstance(result, list)\n   198\t    assert len(result) == 2\n   199\t    assert \"Commit:\" in result[0]\n   200\t    assert \"Author:\" in result[0]\n   201\t    assert \"Date:\" in result[0]\n   202\t    assert \"Message:\" in result[0]\n   203\t\n   204\tdef test_git_log_default(test_repository):\n   205\t    result = git_log(test_repository)\n   206\t\n   207\t    assert isinstance(result, list)\n   208\t    assert len(result) >= 1\n   209\t    assert \"initial commit\" in result[0]\n   210\t\n   211\tdef test_git_create_branch(test_repository):\n   212\t    result = git_create_branch(test_repository, \"new-feature-branch\")\n   213\t\n   214\t    assert \"Created branch 'new-feature-branch'\" in result\n   215\t\n   216\t    branches = [ref.name for ref in test_repository.references]\n   217\t    assert \"new-feature-branch\" in branches\n   218\t\n   219\tdef test_git_create_branch_from_base(test_repository):\n   220\t    test_repository.git.checkout(\"-b\", \"base-branch\")\n   221\t    file_path = Path(test_repository.working_dir) / \"base.txt\"\n   222\t    file_path.write_text(\"base content\")\n   223\t    test_repository.index.add([\"base.txt\"])\n   224\t    test_repository.index.commit(\"base commit\")\n   225\t\n   226\t    result = git_create_branch(test_repository, \"derived-branch\", \"base-branch\")\n   227\t\n   228\t    assert \"Created branch 'derived-branch' from 'base-branch'\" in result\n   229\t\n   230\tdef test_git_show(test_repository):\n   231\t    file_path = Path(test_repository.working_dir) / \"show_test.txt\"\n   232\t    file_path.write_text(\"show content\")\n   233\t    test_repository.index.add([\"show_test.txt\"])\n   234\t    test_repository.index.commit(\"show test commit\")\n   235\t\n   236\t    commit_sha = test_repository.head.commit.hexsha\n   237\t\n   238\t    result = git_show(test_repository, commit_sha)\n   239\t\n   240\t    assert \"Commit:\" in result\n   241\t    assert \"Author:\" in result\n   242\t    assert \"show test commit\" in result\n   243\t    assert \"show_test.txt\" in result\n   244\t\n   245\tdef test_git_show_initial_commit(test_repository):\n   246\t    initial_commit = list(test_repository.iter_commits())[-1]\n   247\t\n   248\t    result = git_show(test_repository, initial_commit.hexsha)\n   249\t\n   250\t    assert \"Commit:\" in result\n   251\t    assert \"initial commit\" in result\n   252\t    assert \"test.txt\" in result\n   253\t\n   254\t\n   255\t# Tests for validate_repo_path (repository scoping security fix)\n   256\t\n   257\tdef test_validate_repo_path_no_restriction():\n   258\t    \"\"\"When no repository restriction is configured, any path should be allowed.\"\"\"\n   259\t    validate_repo_path(Path(\"/any/path\"), None)  # Should not raise\n   260\t\n   261\t\n   262\tdef test_validate_repo_path_exact_match(tmp_path: Path):\n   263\t    \"\"\"When repo_path exactly matches allowed_repository, validation should pass.\"\"\"\n   264\t    allowed = tmp_path / \"repo\"\n   265\t    allowed.mkdir()\n   266\t    validate_repo_path(allowed, allowed)  # Should not raise\n   267\t\n   268\t\n   269\tdef test_validate_repo_path_subdirectory(tmp_path: Path):\n   270\t    \"\"\"When repo_path is a subdirectory of allowed_repository, validation should pass.\"\"\"\n   271\t    allowed = tmp_path / \"repo\"\n   272\t    allowed.mkdir()\n   273\t    subdir = allowed / \"subdir\"\n   274\t    subdir.mkdir()\n   275\t    validate_repo_path(subdir, allowed)  # Should not raise\n   276\t\n   277\t\n   278\tdef test_validate_repo_path_outside_allowed(tmp_path: Path):\n   279\t    \"\"\"When repo_path is outside allowed_repository, validation should raise ValueError.\"\"\"\n   280\t    allowed = tmp_path / \"allowed_repo\"\n   281\t    allowed.mkdir()\n   282\t    outside = tmp_path / \"other_repo\"\n   283\t    outside.mkdir()\n   284\t\n   285\t    with pytest.raises(ValueError) as exc_info:\n   286\t        validate_repo_path(outside, allowed)\n   287\t    assert \"outside the allowed repository\" in str(exc_info.value)\n   288\t\n   289\t\n   290\tdef test_validate_repo_path_traversal_attempt(tmp_path: Path):\n   291\t    \"\"\"Path traversal attempts (../) should be caught and rejected.\"\"\"\n   292\t    allowed = tmp_path / \"allowed_repo\"\n   293\t    allowed.mkdir()\n   294\t    # Attempt to escape via ../\n   295\t    traversal_path = allowed / \"..\" / \"other_repo\"\n   296\t\n   297\t    with pytest.raises(ValueError) as exc_info:\n   298\t        validate_repo_path(traversal_path, allowed)\n   299\t    assert \"outside the allowed repository\" in str(exc_info.value)\n   300\t\n   301\t\n   302\tdef test_validate_repo_path_symlink_escape(tmp_path: Path):\n   303\t    \"\"\"Symlinks pointing outside allowed_repository should be rejected.\"\"\"\n   304\t    allowed = tmp_path / \"allowed_repo\"\n   305\t    allowed.mkdir()\n   306\t    outside = tmp_path / \"outside\"\n   307\t    outside.mkdir()\n   308\t\n   309\t    # Create a symlink inside allowed that points outside\n   310\t    symlink = allowed / \"escape_link\"\n   311\t    symlink.symlink_to(outside)\n   312\t\n   313\t    with pytest.raises(ValueError) as exc_info:\n   314\t        validate_repo_path(symlink, allowed)\n   315\t    assert \"outside the allowed repository\" in str(exc_info.value)\n   316\t# Tests for argument injection protection\n   317\t\n   318\tdef test_git_diff_rejects_flag_injection(test_repository):\n   319\t    \"\"\"git_diff should reject flags that could be used for argument injection.\"\"\"\n   320\t    with pytest.raises(BadName):\n   321\t        git_diff(test_repository, \"--output=/tmp/evil\")\n   322\t\n   323\t    with pytest.raises(BadName):\n   324\t        git_diff(test_repository, \"--help\")\n   325\t\n   326\t    with pytest.raises(BadName):\n   327\t        git_diff(test_repository, \"-p\")\n   328\t\n   329\t\n   330\tdef test_git_checkout_rejects_flag_injection(test_repository):\n   331\t    \"\"\"git_checkout should reject flags that could be used for argument injection.\"\"\"\n   332\t    with pytest.raises(BadName):\n   333\t        git_checkout(test_repository, \"--help\")\n   334\t\n   335\t    with pytest.raises(BadName):\n   336\t        git_checkout(test_repository, \"--orphan=evil\")\n   337\t\n   338\t    with pytest.raises(BadName):\n   339\t        git_checkout(test_repository, \"-f\")\n   340\t\n   341\t\n   342\tdef test_git_diff_allows_valid_refs(test_repository):\n   343\t    \"\"\"git_diff should work normally with valid git refs.\"\"\"\n   344\t    # Get the default branch name\n   345\t    default_branch = test_repository.active_branch.name\n   346\t\n   347\t    # Create a branch with a commit for diffing\n   348\t    test_repository.git.checkout(\"-b\", \"valid-diff-branch\")\n   349\t    file_path = Path(test_repository.working_dir) / \"test.txt\"\n   350\t    file_path.write_text(\"valid diff content\")\n   351\t    test_repository.index.add([\"test.txt\"])\n   352\t    test_repository.index.commit(\"valid diff commit\")\n   353\t\n   354\t    # Test with branch name\n   355\t    result = git_diff(test_repository, default_branch)\n   356\t    assert \"test.txt\" in result\n   357\t\n   358\t    # Test with HEAD~1\n   359\t    result = git_diff(test_repository, \"HEAD~1\")\n   360\t    assert \"test.txt\" in result\n   361\t\n   362\t    # Test with commit hash\n   363\t    commit_sha = test_repository.head.commit.hexsha\n   364\t    result = git_diff(test_repository, commit_sha)\n   365\t    assert result is not None\n   366\t\n   367\t\n   368\tdef test_git_checkout_allows_valid_branches(test_repository):\n   369\t    \"\"\"git_checkout should work normally with valid branch names.\"\"\"\n   370\t    # Get the default branch name\n   371\t    default_branch = test_repository.active_branch.name\n   372\t\n   373\t    # Create a branch to checkout\n   374\t    test_repository.git.branch(\"valid-checkout-branch\")\n   375\t\n   376\t    result = git_checkout(test_repository, \"valid-checkout-branch\")\n   377\t    assert \"Switched to branch 'valid-checkout-branch'\" in result\n   378\t    assert test_repository.active_branch.name == \"valid-checkout-branch\"\n   379\t\n   380\t    # Checkout back to default branch\n   381\t    result = git_checkout(test_repository, default_branch)\n   382\t    assert \"Switched to branch\" in result\n   383\t    assert test_repository.active_branch.name == default_branch\n   384\t\n   385\t\n   386\tdef test_git_diff_rejects_malicious_refs(test_repository):\n   387\t    \"\"\"git_diff should reject refs starting with '-' even if they exist.\n   388\t\n   389\t    This tests defense in depth against an attacker who creates malicious\n   390\t    refs via filesystem manipulation (e.g. using mcp-filesystem to write\n   391\t    to .git/refs/heads/--output=...).\n   392\t    \"\"\"\n   393\t    import os\n   394\t\n   395\t    # Manually create a malicious ref by writing directly to .git/refs\n   396\t    sha = test_repository.head.commit.hexsha\n   397\t    refs_dir = Path(test_repository.git_dir) / \"refs\" / \"heads\"\n   398\t    malicious_ref_path = refs_dir / \"--output=evil.txt\"\n   399\t    malicious_ref_path.write_text(sha)\n   400\t\n   401\t    # Even though the ref exists, it should be rejected\n   402\t    with pytest.raises(BadName):\n   403\t        git_diff(test_repository, \"--output=evil.txt\")\n   404\t\n   405\t    # Verify no file was created (the attack was blocked)\n   406\t    assert not os.path.exists(\"evil.txt\")\n   407\t\n   408\t    # Cleanup\n   409\t    malicious_ref_path.unlink()\n   410\t\n   411\t\n   412\tdef test_git_checkout_rejects_malicious_refs(test_repository):\n   413\t    \"\"\"git_checkout should reject refs starting with '-' even if they exist.\"\"\"\n   414\t    # Manually create a malicious ref\n   415\t    sha = test_repository.head.commit.hexsha\n   416\t    refs_dir = Path(test_repository.git_dir) / \"refs\" / \"heads\"\n   417\t    malicious_ref_path = refs_dir / \"--orphan=evil\"\n   418\t    malicious_ref_path.write_text(sha)\n   419\t\n   420\t    # Even though the ref exists, it should be rejected\n   421\t    with pytest.raises(BadName):\n   422\t        git_checkout(test_repository, \"--orphan=evil\")\n   423\t\n   424\t    # Cleanup\n   425\t    malicious_ref_path.unlink()\n   426\t\n   427\t\n   428\t# Tests for argument injection protection in git_show, git_create_branch,\n   429\t# git_log, and git_branch — matching the existing guards on git_diff and\n   430\t# git_checkout.\n   431\t\n   432\tdef test_git_show_rejects_flag_injection(test_repository):\n   433\t    \"\"\"git_show should reject revisions starting with '-'.\"\"\"\n   434\t    with pytest.raises(BadName):\n   435\t        git_show(test_repository, \"--output=/tmp/evil\")\n   436\t\n   437\t    with pytest.raises(BadName):\n   438\t        git_show(test_repository, \"-p\")\n   439\t\n   440\t\n   441\tdef test_git_show_rejects_malicious_refs(test_repository):\n   442\t    \"\"\"git_show should reject refs starting with '-' even if they exist.\"\"\"\n   443\t    sha = test_repository.head.commit.hexsha\n   444\t    refs_dir = Path(test_repository.git_dir) / \"refs\" / \"heads\"\n   445\t    malicious_ref_path = refs_dir / \"--format=evil\"\n   446\t    malicious_ref_path.write_text(sha)\n   447\t\n   448\t    with pytest.raises(BadName):\n   449\t        git_show(test_repository, \"--format=evil\")\n   450\t\n   451\t    malicious_ref_path.unlink()\n   452\t\n   453\t\n   454\tdef test_git_create_branch_rejects_flag_injection(test_repository):\n   455\t    \"\"\"git_create_branch should reject branch names starting with '-'.\"\"\"\n   456\t    with pytest.raises(BadName):\n   457\t        git_create_branch(test_repository, \"--track=evil\")\n   458\t\n   459\t    with pytest.raises(BadName):\n   460\t        git_create_branch(test_repository, \"-f\")\n   461\t\n   462\t\n   463\tdef test_git_create_branch_rejects_base_branch_flag_injection(test_repository):\n   464\t    \"\"\"git_create_branch should reject base branch names starting with '-'.\"\"\"\n   465\t    with pytest.raises(BadName):\n   466\t        git_create_branch(test_repository, \"new-branch\", \"--track=evil\")\n   467\t\n   468\t\n   469\tdef test_git_log_rejects_timestamp_flag_injection(test_repository):\n   470\t    \"\"\"git_log should reject timestamps starting with '-'.\"\"\"\n   471\t    with pytest.raises(ValueError):\n   472\t        git_log(test_repository, start_timestamp=\"--exec=evil\")\n   473\t\n   474\t    with pytest.raises(ValueError):\n   475\t        git_log(test_repository, end_timestamp=\"--exec=evil\")\n   476\t\n   477\t\n   478\tdef test_git_branch_rejects_contains_flag_injection(test_repository):\n   479\t    \"\"\"git_branch should reject contains/not_contains values starting with '-'.\"\"\"\n   480\t    with pytest.raises(BadName):\n   481\t        git_branch(test_repository, \"local\", contains=\"--exec=evil\")\n   482\t\n   483\t    with pytest.raises(BadName):\n   484\t        git_branch(test_repository, \"local\", not_contains=\"--exec=evil\")\n","exit_code":0,"status":"completed"}}
