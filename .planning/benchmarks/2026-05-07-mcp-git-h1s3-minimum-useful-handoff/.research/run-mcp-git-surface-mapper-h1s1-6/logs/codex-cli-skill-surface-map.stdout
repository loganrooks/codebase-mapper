{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/mcp_server_git/server.py | sed -n '261,620p'\"","aggregated_output":"   261\t        raise BadName(f\"Invalid contains value: '{contains}' - cannot start with '-'\")\n   262\t    if not_contains and not_contains.startswith(\"-\"):\n   263\t        raise BadName(f\"Invalid not_contains value: '{not_contains}' - cannot start with '-'\")\n   264\t\n   265\t    match contains:\n   266\t        case None:\n   267\t            contains_sha = (None,)\n   268\t        case _:\n   269\t            contains_sha = (\"--contains\", contains)\n   270\t\n   271\t    match not_contains:\n   272\t        case None:\n   273\t            not_contains_sha = (None,)\n   274\t        case _:\n   275\t            not_contains_sha = (\"--no-contains\", not_contains)\n   276\t\n   277\t    match branch_type:\n   278\t        case 'local':\n   279\t            b_type = None\n   280\t        case 'remote':\n   281\t            b_type = \"-r\"\n   282\t        case 'all':\n   283\t            b_type = \"-a\"\n   284\t        case _:\n   285\t            return f\"Invalid branch type: {branch_type}\"\n   286\t\n   287\t    # None value will be auto deleted by GitPython\n   288\t    branch_info = repo.git.branch(b_type, *contains_sha, *not_contains_sha)\n   289\t\n   290\t    return branch_info\n   291\t\n   292\t\n   293\tasync def serve(repository: Path | None) -> None:\n   294\t    logger = logging.getLogger(__name__)\n   295\t\n   296\t    if repository is not None:\n   297\t        try:\n   298\t            git.Repo(repository)\n   299\t            logger.info(f\"Using repository at {repository}\")\n   300\t        except git.InvalidGitRepositoryError:\n   301\t            logger.error(f\"{repository} is not a valid Git repository\")\n   302\t            return\n   303\t\n   304\t    server = Server(\"mcp-git\")\n   305\t\n   306\t    @server.list_tools()\n   307\t    async def list_tools() -> list[Tool]:\n   308\t        return [\n   309\t            Tool(\n   310\t                name=GitTools.STATUS,\n   311\t                description=\"Shows the working tree status\",\n   312\t                inputSchema=GitStatus.model_json_schema(),\n   313\t                annotations=ToolAnnotations(\n   314\t                    readOnlyHint=True,\n   315\t                    destructiveHint=False,\n   316\t                    idempotentHint=True,\n   317\t                    openWorldHint=False,\n   318\t                ),\n   319\t            ),\n   320\t            Tool(\n   321\t                name=GitTools.DIFF_UNSTAGED,\n   322\t                description=\"Shows changes in the working directory that are not yet staged\",\n   323\t                inputSchema=GitDiffUnstaged.model_json_schema(),\n   324\t                annotations=ToolAnnotations(\n   325\t                    readOnlyHint=True,\n   326\t                    destructiveHint=False,\n   327\t                    idempotentHint=True,\n   328\t                    openWorldHint=False,\n   329\t                ),\n   330\t            ),\n   331\t            Tool(\n   332\t                name=GitTools.DIFF_STAGED,\n   333\t                description=\"Shows changes that are staged for commit\",\n   334\t                inputSchema=GitDiffStaged.model_json_schema(),\n   335\t                annotations=ToolAnnotations(\n   336\t                    readOnlyHint=True,\n   337\t                    destructiveHint=False,\n   338\t                    idempotentHint=True,\n   339\t                    openWorldHint=False,\n   340\t                ),\n   341\t            ),\n   342\t            Tool(\n   343\t                name=GitTools.DIFF,\n   344\t                description=\"Shows differences between branches or commits\",\n   345\t                inputSchema=GitDiff.model_json_schema(),\n   346\t                annotations=ToolAnnotations(\n   347\t                    readOnlyHint=True,\n   348\t                    destructiveHint=False,\n   349\t                    idempotentHint=True,\n   350\t                    openWorldHint=False,\n   351\t                ),\n   352\t            ),\n   353\t            Tool(\n   354\t                name=GitTools.COMMIT,\n   355\t                description=\"Records changes to the repository\",\n   356\t                inputSchema=GitCommit.model_json_schema(),\n   357\t                annotations=ToolAnnotations(\n   358\t                    readOnlyHint=False,\n   359\t                    destructiveHint=False,\n   360\t                    idempotentHint=False,\n   361\t                    openWorldHint=False,\n   362\t                ),\n   363\t            ),\n   364\t            Tool(\n   365\t                name=GitTools.ADD,\n   366\t                description=\"Adds file contents to the staging area\",\n   367\t                inputSchema=GitAdd.model_json_schema(),\n   368\t                annotations=ToolAnnotations(\n   369\t                    readOnlyHint=False,\n   370\t                    destructiveHint=False,\n   371\t                    idempotentHint=True,\n   372\t                    openWorldHint=False,\n   373\t                ),\n   374\t            ),\n   375\t            Tool(\n   376\t                name=GitTools.RESET,\n   377\t                description=\"Unstages all staged changes\",\n   378\t                inputSchema=GitReset.model_json_schema(),\n   379\t                annotations=ToolAnnotations(\n   380\t                    readOnlyHint=False,\n   381\t                    destructiveHint=True,\n   382\t                    idempotentHint=True,\n   383\t                    openWorldHint=False,\n   384\t                ),\n   385\t            ),\n   386\t            Tool(\n   387\t                name=GitTools.LOG,\n   388\t                description=\"Shows the commit logs\",\n   389\t                inputSchema=GitLog.model_json_schema(),\n   390\t                annotations=ToolAnnotations(\n   391\t                    readOnlyHint=True,\n   392\t                    destructiveHint=False,\n   393\t                    idempotentHint=True,\n   394\t                    openWorldHint=False,\n   395\t                ),\n   396\t            ),\n   397\t            Tool(\n   398\t                name=GitTools.CREATE_BRANCH,\n   399\t                description=\"Creates a new branch from an optional base branch\",\n   400\t                inputSchema=GitCreateBranch.model_json_schema(),\n   401\t                annotations=ToolAnnotations(\n   402\t                    readOnlyHint=False,\n   403\t                    destructiveHint=False,\n   404\t                    idempotentHint=False,\n   405\t                    openWorldHint=False,\n   406\t                ),\n   407\t            ),\n   408\t            Tool(\n   409\t                name=GitTools.CHECKOUT,\n   410\t                description=\"Switches branches\",\n   411\t                inputSchema=GitCheckout.model_json_schema(),\n   412\t                annotations=ToolAnnotations(\n   413\t                    readOnlyHint=False,\n   414\t                    destructiveHint=False,\n   415\t                    idempotentHint=False,\n   416\t                    openWorldHint=False,\n   417\t                ),\n   418\t            ),\n   419\t            Tool(\n   420\t                name=GitTools.SHOW,\n   421\t                description=\"Shows the contents of a commit\",\n   422\t                inputSchema=GitShow.model_json_schema(),\n   423\t                annotations=ToolAnnotations(\n   424\t                    readOnlyHint=True,\n   425\t                    destructiveHint=False,\n   426\t                    idempotentHint=True,\n   427\t                    openWorldHint=False,\n   428\t                ),\n   429\t            ),\n   430\t            Tool(\n   431\t                name=GitTools.BRANCH,\n   432\t                description=\"List Git branches\",\n   433\t                inputSchema=GitBranch.model_json_schema(),\n   434\t                annotations=ToolAnnotations(\n   435\t                    readOnlyHint=True,\n   436\t                    destructiveHint=False,\n   437\t                    idempotentHint=True,\n   438\t                    openWorldHint=False,\n   439\t                ),\n   440\t            )\n   441\t        ]\n   442\t\n   443\t    async def list_repos() -> Sequence[str]:\n   444\t        async def by_roots() -> Sequence[str]:\n   445\t            if not isinstance(server.request_context.session, ServerSession):\n   446\t                raise TypeError(\"server.request_context.session must be a ServerSession\")\n   447\t\n   448\t            if not server.request_context.session.check_client_capability(\n   449\t                ClientCapabilities(roots=RootsCapability())\n   450\t            ):\n   451\t                return []\n   452\t\n   453\t            roots_result: ListRootsResult = await server.request_context.session.list_roots()\n   454\t            logger.debug(f\"Roots result: {roots_result}\")\n   455\t            repo_paths = []\n   456\t            for root in roots_result.roots:\n   457\t                path = root.uri.path\n   458\t                try:\n   459\t                    git.Repo(path)\n   460\t                    repo_paths.append(str(path))\n   461\t                except git.InvalidGitRepositoryError:\n   462\t                    pass\n   463\t            return repo_paths\n   464\t\n   465\t        def by_commandline() -> Sequence[str]:\n   466\t            return [str(repository)] if repository is not None else []\n   467\t\n   468\t        cmd_repos = by_commandline()\n   469\t        root_repos = await by_roots()\n   470\t        return [*root_repos, *cmd_repos]\n   471\t\n   472\t    @server.call_tool()\n   473\t    async def call_tool(name: str, arguments: dict) -> list[TextContent]:\n   474\t        repo_path = Path(arguments[\"repo_path\"])\n   475\t\n   476\t        # Validate repo_path is within allowed repository\n   477\t        validate_repo_path(repo_path, repository)\n   478\t\n   479\t        # For all commands, we need an existing repo\n   480\t        repo = git.Repo(repo_path)\n   481\t\n   482\t        match name:\n   483\t            case GitTools.STATUS:\n   484\t                status = git_status(repo)\n   485\t                return [TextContent(\n   486\t                    type=\"text\",\n   487\t                    text=f\"Repository status:\\n{status}\"\n   488\t                )]\n   489\t\n   490\t            case GitTools.DIFF_UNSTAGED:\n   491\t                diff = git_diff_unstaged(repo, arguments.get(\"context_lines\", DEFAULT_CONTEXT_LINES))\n   492\t                return [TextContent(\n   493\t                    type=\"text\",\n   494\t                    text=f\"Unstaged changes:\\n{diff}\"\n   495\t                )]\n   496\t\n   497\t            case GitTools.DIFF_STAGED:\n   498\t                diff = git_diff_staged(repo, arguments.get(\"context_lines\", DEFAULT_CONTEXT_LINES))\n   499\t                return [TextContent(\n   500\t                    type=\"text\",\n   501\t                    text=f\"Staged changes:\\n{diff}\"\n   502\t                )]\n   503\t\n   504\t            case GitTools.DIFF:\n   505\t                diff = git_diff(repo, arguments[\"target\"], arguments.get(\"context_lines\", DEFAULT_CONTEXT_LINES))\n   506\t                return [TextContent(\n   507\t                    type=\"text\",\n   508\t                    text=f\"Diff with {arguments['target']}:\\n{diff}\"\n   509\t                )]\n   510\t\n   511\t            case GitTools.COMMIT:\n   512\t                result = git_commit(repo, arguments[\"message\"])\n   513\t                return [TextContent(\n   514\t                    type=\"text\",\n   515\t                    text=result\n   516\t                )]\n   517\t\n   518\t            case GitTools.ADD:\n   519\t                result = git_add(repo, arguments[\"files\"])\n   520\t                return [TextContent(\n   521\t                    type=\"text\",\n   522\t                    text=result\n   523\t                )]\n   524\t\n   525\t            case GitTools.RESET:\n   526\t                result = git_reset(repo)\n   527\t                return [TextContent(\n   528\t                    type=\"text\",\n   529\t                    text=result\n   530\t                )]\n   531\t\n   532\t            # Update the LOG case:\n   533\t            case GitTools.LOG:\n   534\t                log = git_log(\n   535\t                    repo,\n   536\t                    arguments.get(\"max_count\", 10),\n   537\t                    arguments.get(\"start_timestamp\"),\n   538\t                    arguments.get(\"end_timestamp\")\n   539\t                )\n   540\t                return [TextContent(\n   541\t                    type=\"text\",\n   542\t                    text=\"Commit history:\\n\" + \"\\n\".join(log)\n   543\t                )]\n   544\t\n   545\t            case GitTools.CREATE_BRANCH:\n   546\t                result = git_create_branch(\n   547\t                    repo,\n   548\t                    arguments[\"branch_name\"],\n   549\t                    arguments.get(\"base_branch\")\n   550\t                )\n   551\t                return [TextContent(\n   552\t                    type=\"text\",\n   553\t                    text=result\n   554\t                )]\n   555\t\n   556\t            case GitTools.CHECKOUT:\n   557\t                result = git_checkout(repo, arguments[\"branch_name\"])\n   558\t                return [TextContent(\n   559\t                    type=\"text\",\n   560\t                    text=result\n   561\t                )]\n   562\t\n   563\t            case GitTools.SHOW:\n   564\t                result = git_show(repo, arguments[\"revision\"])\n   565\t                return [TextContent(\n   566\t                    type=\"text\",\n   567\t                    text=result\n   568\t                )]\n   569\t\n   570\t            case GitTools.BRANCH:\n   571\t                result = git_branch(\n   572\t                    repo,\n   573\t                    arguments.get(\"branch_type\", 'local'),\n   574\t                    arguments.get(\"contains\", None),\n   575\t                    arguments.get(\"not_contains\", None),\n   576\t                )\n   577\t                return [TextContent(\n   578\t                    type=\"text\",\n   579\t                    text=result\n   580\t                )]\n   581\t\n   582\t            case _:\n   583\t                raise ValueError(f\"Unknown tool: {name}\")\n   584\t\n   585\t    options = server.create_initialization_options()\n   586\t    async with stdio_server() as (read_stream, write_stream):\n   587\t        await server.run(read_stream, write_stream, options, raise_exceptions=True)\n","exit_code":0,"status":"completed"}}
