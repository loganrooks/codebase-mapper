{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/mcp_server_git/server.py | sed -n '341,640p'\"","aggregated_output":"   341\t            ),\n   342\t            Tool(\n   343\t                name=GitTools.DIFF,\n   344\t                description=\"Shows differences between branches or commits\",\n   345\t                inputSchema=GitDiff.model_json_schema(),\n   346\t                annotations=ToolAnnotations(\n   347\t                    readOnlyHint=True,\n   348\t                    destructiveHint=False,\n   349\t                    idempotentHint=True,\n   350\t                    openWorldHint=False,\n   351\t                ),\n   352\t            ),\n   353\t            Tool(\n   354\t                name=GitTools.COMMIT,\n   355\t                description=\"Records changes to the repository\",\n   356\t                inputSchema=GitCommit.model_json_schema(),\n   357\t                annotations=ToolAnnotations(\n   358\t                    readOnlyHint=False,\n   359\t                    destructiveHint=False,\n   360\t                    idempotentHint=False,\n   361\t                    openWorldHint=False,\n   362\t                ),\n   363\t            ),\n   364\t            Tool(\n   365\t                name=GitTools.ADD,\n   366\t                description=\"Adds file contents to the staging area\",\n   367\t                inputSchema=GitAdd.model_json_schema(),\n   368\t                annotations=ToolAnnotations(\n   369\t                    readOnlyHint=False,\n   370\t                    destructiveHint=False,\n   371\t                    idempotentHint=True,\n   372\t                    openWorldHint=False,\n   373\t                ),\n   374\t            ),\n   375\t            Tool(\n   376\t                name=GitTools.RESET,\n   377\t                description=\"Unstages all staged changes\",\n   378\t                inputSchema=GitReset.model_json_schema(),\n   379\t                annotations=ToolAnnotations(\n   380\t                    readOnlyHint=False,\n   381\t                    destructiveHint=True,\n   382\t                    idempotentHint=True,\n   383\t                    openWorldHint=False,\n   384\t                ),\n   385\t            ),\n   386\t            Tool(\n   387\t                name=GitTools.LOG,\n   388\t                description=\"Shows the commit logs\",\n   389\t                inputSchema=GitLog.model_json_schema(),\n   390\t                annotations=ToolAnnotations(\n   391\t                    readOnlyHint=True,\n   392\t                    destructiveHint=False,\n   393\t                    idempotentHint=True,\n   394\t                    openWorldHint=False,\n   395\t                ),\n   396\t            ),\n   397\t            Tool(\n   398\t                name=GitTools.CREATE_BRANCH,\n   399\t                description=\"Creates a new branch from an optional base branch\",\n   400\t                inputSchema=GitCreateBranch.model_json_schema(),\n   401\t                annotations=ToolAnnotations(\n   402\t                    readOnlyHint=False,\n   403\t                    destructiveHint=False,\n   404\t                    idempotentHint=False,\n   405\t                    openWorldHint=False,\n   406\t                ),\n   407\t            ),\n   408\t            Tool(\n   409\t                name=GitTools.CHECKOUT,\n   410\t                description=\"Switches branches\",\n   411\t                inputSchema=GitCheckout.model_json_schema(),\n   412\t                annotations=ToolAnnotations(\n   413\t                    readOnlyHint=False,\n   414\t                    destructiveHint=False,\n   415\t                    idempotentHint=False,\n   416\t                    openWorldHint=False,\n   417\t                ),\n   418\t            ),\n   419\t            Tool(\n   420\t                name=GitTools.SHOW,\n   421\t                description=\"Shows the contents of a commit\",\n   422\t                inputSchema=GitShow.model_json_schema(),\n   423\t                annotations=ToolAnnotations(\n   424\t                    readOnlyHint=True,\n   425\t                    destructiveHint=False,\n   426\t                    idempotentHint=True,\n   427\t                    openWorldHint=False,\n   428\t                ),\n   429\t            ),\n   430\t            Tool(\n   431\t                name=GitTools.BRANCH,\n   432\t                description=\"List Git branches\",\n   433\t                inputSchema=GitBranch.model_json_schema(),\n   434\t                annotations=ToolAnnotations(\n   435\t                    readOnlyHint=True,\n   436\t                    destructiveHint=False,\n   437\t                    idempotentHint=True,\n   438\t                    openWorldHint=False,\n   439\t                ),\n   440\t            )\n   441\t        ]\n   442\t\n   443\t    async def list_repos() -> Sequence[str]:\n   444\t        async def by_roots() -> Sequence[str]:\n   445\t            if not isinstance(server.request_context.session, ServerSession):\n   446\t                raise TypeError(\"server.request_context.session must be a ServerSession\")\n   447\t\n   448\t            if not server.request_context.session.check_client_capability(\n   449\t                ClientCapabilities(roots=RootsCapability())\n   450\t            ):\n   451\t                return []\n   452\t\n   453\t            roots_result: ListRootsResult = await server.request_context.session.list_roots()\n   454\t            logger.debug(f\"Roots result: {roots_result}\")\n   455\t            repo_paths = []\n   456\t            for root in roots_result.roots:\n   457\t                path = root.uri.path\n   458\t                try:\n   459\t                    git.Repo(path)\n   460\t                    repo_paths.append(str(path))\n   461\t                except git.InvalidGitRepositoryError:\n   462\t                    pass\n   463\t            return repo_paths\n   464\t\n   465\t        def by_commandline() -> Sequence[str]:\n   466\t            return [str(repository)] if repository is not None else []\n   467\t\n   468\t        cmd_repos = by_commandline()\n   469\t        root_repos = await by_roots()\n   470\t        return [*root_repos, *cmd_repos]\n   471\t\n   472\t    @server.call_tool()\n   473\t    async def call_tool(name: str, arguments: dict) -> list[TextContent]:\n   474\t        repo_path = Path(arguments[\"repo_path\"])\n   475\t\n   476\t        # Validate repo_path is within allowed repository\n   477\t        validate_repo_path(repo_path, repository)\n   478\t\n   479\t        # For all commands, we need an existing repo\n   480\t        repo = git.Repo(repo_path)\n   481\t\n   482\t        match name:\n   483\t            case GitTools.STATUS:\n   484\t                status = git_status(repo)\n   485\t                return [TextContent(\n   486\t                    type=\"text\",\n   487\t                    text=f\"Repository status:\\n{status}\"\n   488\t                )]\n   489\t\n   490\t            case GitTools.DIFF_UNSTAGED:\n   491\t                diff = git_diff_unstaged(repo, arguments.get(\"context_lines\", DEFAULT_CONTEXT_LINES))\n   492\t                return [TextContent(\n   493\t                    type=\"text\",\n   494\t                    text=f\"Unstaged changes:\\n{diff}\"\n   495\t                )]\n   496\t\n   497\t            case GitTools.DIFF_STAGED:\n   498\t                diff = git_diff_staged(repo, arguments.get(\"context_lines\", DEFAULT_CONTEXT_LINES))\n   499\t                return [TextContent(\n   500\t                    type=\"text\",\n   501\t                    text=f\"Staged changes:\\n{diff}\"\n   502\t                )]\n   503\t\n   504\t            case GitTools.DIFF:\n   505\t                diff = git_diff(repo, arguments[\"target\"], arguments.get(\"context_lines\", DEFAULT_CONTEXT_LINES))\n   506\t                return [TextContent(\n   507\t                    type=\"text\",\n   508\t                    text=f\"Diff with {arguments['target']}:\\n{diff}\"\n   509\t                )]\n   510\t\n   511\t            case GitTools.COMMIT:\n   512\t                result = git_commit(repo, arguments[\"message\"])\n   513\t                return [TextContent(\n   514\t                    type=\"text\",\n   515\t                    text=result\n   516\t                )]\n   517\t\n   518\t            case GitTools.ADD:\n   519\t                result = git_add(repo, arguments[\"files\"])\n   520\t                return [TextContent(\n   521\t                    type=\"text\",\n   522\t                    text=result\n   523\t                )]\n   524\t\n   525\t            case GitTools.RESET:\n   526\t                result = git_reset(repo)\n   527\t                return [TextContent(\n   528\t                    type=\"text\",\n   529\t                    text=result\n   530\t                )]\n   531\t\n   532\t            # Update the LOG case:\n   533\t            case GitTools.LOG:\n   534\t                log = git_log(\n   535\t                    repo,\n   536\t                    arguments.get(\"max_count\", 10),\n   537\t                    arguments.get(\"start_timestamp\"),\n   538\t                    arguments.get(\"end_timestamp\")\n   539\t                )\n   540\t                return [TextContent(\n   541\t                    type=\"text\",\n   542\t                    text=\"Commit history:\\n\" + \"\\n\".join(log)\n   543\t                )]\n   544\t\n   545\t            case GitTools.CREATE_BRANCH:\n   546\t                result = git_create_branch(\n   547\t                    repo,\n   548\t                    arguments[\"branch_name\"],\n   549\t                    arguments.get(\"base_branch\")\n   550\t                )\n   551\t                return [TextContent(\n   552\t                    type=\"text\",\n   553\t                    text=result\n   554\t                )]\n   555\t\n   556\t            case GitTools.CHECKOUT:\n   557\t                result = git_checkout(repo, arguments[\"branch_name\"])\n   558\t                return [TextContent(\n   559\t                    type=\"text\",\n   560\t                    text=result\n   561\t                )]\n   562\t\n   563\t            case GitTools.SHOW:\n   564\t                result = git_show(repo, arguments[\"revision\"])\n   565\t                return [TextContent(\n   566\t                    type=\"text\",\n   567\t                    text=result\n   568\t                )]\n   569\t\n   570\t            case GitTools.BRANCH:\n   571\t                result = git_branch(\n   572\t                    repo,\n   573\t                    arguments.get(\"branch_type\", 'local'),\n   574\t                    arguments.get(\"contains\", None),\n   575\t                    arguments.get(\"not_contains\", None),\n   576\t                )\n   577\t                return [TextContent(\n   578\t                    type=\"text\",\n   579\t                    text=result\n   580\t                )]\n   581\t\n   582\t            case _:\n   583\t                raise ValueError(f\"Unknown tool: {name}\")\n   584\t\n   585\t    options = server.create_initialization_options()\n   586\t    async with stdio_server() as (read_stream, write_stream):\n   587\t        await server.run(read_stream, write_stream, options, raise_exceptions=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/mcp_server_git/server.py | sed -n '1,340p'\"","aggregated_output":"     1\timport logging\n     2\tfrom pathlib import Path\n     3\tfrom typing import Sequence, Optional\n     4\tfrom mcp.server import Server\n     5\tfrom mcp.server.session import ServerSession\n     6\tfrom mcp.server.stdio import stdio_server\n     7\tfrom mcp.types import (\n     8\t    ClientCapabilities,\n     9\t    TextContent,\n    10\t    Tool,\n    11\t    ListRootsResult,\n    12\t    RootsCapability,\n    13\t    ToolAnnotations,\n    14\t)\n    15\tfrom enum import Enum\n    16\timport git\n    17\tfrom git.exc import BadName\n    18\tfrom pydantic import BaseModel, Field\n    19\t\n    20\t# Default number of context lines to show in diff output\n    21\tDEFAULT_CONTEXT_LINES = 3\n    22\t\n    23\tclass GitStatus(BaseModel):\n    24\t    repo_path: str\n    25\t\n    26\tclass GitDiffUnstaged(BaseModel):\n    27\t    repo_path: str\n    28\t    context_lines: int = DEFAULT_CONTEXT_LINES\n    29\t\n    30\tclass GitDiffStaged(BaseModel):\n    31\t    repo_path: str\n    32\t    context_lines: int = DEFAULT_CONTEXT_LINES\n    33\t\n    34\tclass GitDiff(BaseModel):\n    35\t    repo_path: str\n    36\t    target: str\n    37\t    context_lines: int = DEFAULT_CONTEXT_LINES\n    38\t\n    39\tclass GitCommit(BaseModel):\n    40\t    repo_path: str\n    41\t    message: str\n    42\t\n    43\tclass GitAdd(BaseModel):\n    44\t    repo_path: str\n    45\t    files: list[str]\n    46\t\n    47\tclass GitReset(BaseModel):\n    48\t    repo_path: str\n    49\t\n    50\tclass GitLog(BaseModel):\n    51\t    repo_path: str\n    52\t    max_count: int = 10\n    53\t    start_timestamp: Optional[str] = Field(\n    54\t        None,\n    55\t        description=\"Start timestamp for filtering commits. Accepts: ISO 8601 format (e.g., '2024-01-15T14:30:25'), relative dates (e.g., '2 weeks ago', 'yesterday'), or absolute dates (e.g., '2024-01-15', 'Jan 15 2024')\"\n    56\t    )\n    57\t    end_timestamp: Optional[str] = Field(\n    58\t        None,\n    59\t        description=\"End timestamp for filtering commits. Accepts: ISO 8601 format (e.g., '2024-01-15T14:30:25'), relative dates (e.g., '2 weeks ago', 'yesterday'), or absolute dates (e.g., '2024-01-15', 'Jan 15 2024')\"\n    60\t    )\n    61\t\n    62\tclass GitCreateBranch(BaseModel):\n    63\t    repo_path: str\n    64\t    branch_name: str\n    65\t    base_branch: str | None = None\n    66\t\n    67\tclass GitCheckout(BaseModel):\n    68\t    repo_path: str\n    69\t    branch_name: str\n    70\t\n    71\tclass GitShow(BaseModel):\n    72\t    repo_path: str\n    73\t    revision: str\n    74\t\n    75\t\n    76\t\n    77\tclass GitBranch(BaseModel):\n    78\t    repo_path: str = Field(\n    79\t        ...,\n    80\t        description=\"The path to the Git repository.\",\n    81\t    )\n    82\t    branch_type: str = Field(\n    83\t        ...,\n    84\t        description=\"Whether to list local branches ('local'), remote branches ('remote') or all branches('all').\",\n    85\t    )\n    86\t    contains: Optional[str] = Field(\n    87\t        None,\n    88\t        description=\"The commit sha that branch should contain. Do not pass anything to this param if no commit sha is specified\",\n    89\t    )\n    90\t    not_contains: Optional[str] = Field(\n    91\t        None,\n    92\t        description=\"The commit sha that branch should NOT contain. Do not pass anything to this param if no commit sha is specified\",\n    93\t    )\n    94\t\n    95\t\n    96\tclass GitTools(str, Enum):\n    97\t    STATUS = \"git_status\"\n    98\t    DIFF_UNSTAGED = \"git_diff_unstaged\"\n    99\t    DIFF_STAGED = \"git_diff_staged\"\n   100\t    DIFF = \"git_diff\"\n   101\t    COMMIT = \"git_commit\"\n   102\t    ADD = \"git_add\"\n   103\t    RESET = \"git_reset\"\n   104\t    LOG = \"git_log\"\n   105\t    CREATE_BRANCH = \"git_create_branch\"\n   106\t    CHECKOUT = \"git_checkout\"\n   107\t    SHOW = \"git_show\"\n   108\t\n   109\t    BRANCH = \"git_branch\"\n   110\t\n   111\tdef git_status(repo: git.Repo) -> str:\n   112\t    return repo.git.status()\n   113\t\n   114\tdef git_diff_unstaged(repo: git.Repo, context_lines: int = DEFAULT_CONTEXT_LINES) -> str:\n   115\t    return repo.git.diff(f\"--unified={context_lines}\")\n   116\t\n   117\tdef git_diff_staged(repo: git.Repo, context_lines: int = DEFAULT_CONTEXT_LINES) -> str:\n   118\t    return repo.git.diff(f\"--unified={context_lines}\", \"--cached\")\n   119\t\n   120\tdef git_diff(repo: git.Repo, target: str, context_lines: int = DEFAULT_CONTEXT_LINES) -> str:\n   121\t    # Defense in depth: reject targets starting with '-' to prevent flag injection,\n   122\t    # even if a malicious ref with that name exists (e.g. via filesystem manipulation)\n   123\t    if target.startswith(\"-\"):\n   124\t        raise BadName(f\"Invalid target: '{target}' - cannot start with '-'\")\n   125\t    repo.rev_parse(target)  # Validates target is a real git ref, throws BadName if not\n   126\t    return repo.git.diff(f\"--unified={context_lines}\", target)\n   127\t\n   128\tdef git_commit(repo: git.Repo, message: str) -> str:\n   129\t    commit = repo.index.commit(message)\n   130\t    return f\"Changes committed successfully with hash {commit.hexsha}\"\n   131\t\n   132\tdef git_add(repo: git.Repo, files: list[str]) -> str:\n   133\t    if files == [\".\"]:\n   134\t        repo.git.add(\".\")\n   135\t    else:\n   136\t        # Use '--' to prevent files starting with '-' from being interpreted as options\n   137\t        repo.git.add(\"--\", *files)\n   138\t    return \"Files staged successfully\"\n   139\t\n   140\tdef git_reset(repo: git.Repo) -> str:\n   141\t    repo.index.reset()\n   142\t    return \"All staged changes reset\"\n   143\t\n   144\tdef git_log(repo: git.Repo, max_count: int = 10, start_timestamp: Optional[str] = None, end_timestamp: Optional[str] = None) -> list[str]:\n   145\t    if start_timestamp or end_timestamp:\n   146\t        # Defense in depth: reject timestamps starting with '-' to prevent flag injection\n   147\t        if start_timestamp and start_timestamp.startswith(\"-\"):\n   148\t            raise ValueError(f\"Invalid start_timestamp: '{start_timestamp}' - cannot start with '-'\")\n   149\t        if end_timestamp and end_timestamp.startswith(\"-\"):\n   150\t            raise ValueError(f\"Invalid end_timestamp: '{end_timestamp}' - cannot start with '-'\")\n   151\t        # Use git log command with date filtering\n   152\t        args = []\n   153\t        if start_timestamp:\n   154\t            args.extend(['--since', start_timestamp])\n   155\t        if end_timestamp:\n   156\t            args.extend(['--until', end_timestamp])\n   157\t        args.extend(['--format=%H%n%an%n%ad%n%s%n'])\n   158\t\n   159\t        log_output = repo.git.log(*args).split('\\n')\n   160\t\n   161\t        log = []\n   162\t        # Process commits in groups of 4 (hash, author, date, message)\n   163\t        for i in range(0, len(log_output), 4):\n   164\t            if i + 3 < len(log_output) and len(log) < max_count:\n   165\t                log.append(\n   166\t                    f\"Commit: {log_output[i]}\\n\"\n   167\t                    f\"Author: {log_output[i+1]}\\n\"\n   168\t                    f\"Date: {log_output[i+2]}\\n\"\n   169\t                    f\"Message: {log_output[i+3]}\\n\"\n   170\t                )\n   171\t        return log\n   172\t    else:\n   173\t        # Use existing logic for simple log without date filtering\n   174\t        commits = list(repo.iter_commits(max_count=max_count))\n   175\t        log = []\n   176\t        for commit in commits:\n   177\t            log.append(\n   178\t                f\"Commit: {commit.hexsha!r}\\n\"\n   179\t                f\"Author: {commit.author!r}\\n\"\n   180\t                f\"Date: {commit.authored_datetime}\\n\"\n   181\t                f\"Message: {commit.message!r}\\n\"\n   182\t            )\n   183\t        return log\n   184\t\n   185\tdef git_create_branch(repo: git.Repo, branch_name: str, base_branch: str | None = None) -> str:\n   186\t    # Defense in depth: reject names starting with '-' to prevent flag injection\n   187\t    if branch_name.startswith(\"-\"):\n   188\t        raise BadName(f\"Invalid branch name: '{branch_name}' - cannot start with '-'\")\n   189\t    if base_branch and base_branch.startswith(\"-\"):\n   190\t        raise BadName(f\"Invalid base branch: '{base_branch}' - cannot start with '-'\")\n   191\t    if base_branch:\n   192\t        base = repo.references[base_branch]\n   193\t    else:\n   194\t        base = repo.active_branch\n   195\t\n   196\t    repo.create_head(branch_name, base)\n   197\t    return f\"Created branch '{branch_name}' from '{base.name}'\"\n   198\t\n   199\tdef git_checkout(repo: git.Repo, branch_name: str) -> str:\n   200\t    # Defense in depth: reject branch names starting with '-' to prevent flag injection,\n   201\t    # even if a malicious ref with that name exists (e.g. via filesystem manipulation)\n   202\t    if branch_name.startswith(\"-\"):\n   203\t        raise BadName(f\"Invalid branch name: '{branch_name}' - cannot start with '-'\")\n   204\t    repo.rev_parse(branch_name)  # Validates branch_name is a real git ref, throws BadName if not\n   205\t    repo.git.checkout(branch_name)\n   206\t    return f\"Switched to branch '{branch_name}'\"\n   207\t\n   208\t\n   209\t\n   210\tdef git_show(repo: git.Repo, revision: str) -> str:\n   211\t    # Defense in depth: reject revisions starting with '-' to prevent flag injection,\n   212\t    # even if a malicious ref with that name exists (e.g. via filesystem manipulation)\n   213\t    if revision.startswith(\"-\"):\n   214\t        raise BadName(f\"Invalid revision: '{revision}' - cannot start with '-'\")\n   215\t    commit = repo.commit(revision)\n   216\t    output = [\n   217\t        f\"Commit: {commit.hexsha!r}\\n\"\n   218\t        f\"Author: {commit.author!r}\\n\"\n   219\t        f\"Date: {commit.authored_datetime!r}\\n\"\n   220\t        f\"Message: {commit.message!r}\\n\"\n   221\t    ]\n   222\t    if commit.parents:\n   223\t        parent = commit.parents[0]\n   224\t        diff = parent.diff(commit, create_patch=True)\n   225\t    else:\n   226\t        diff = commit.diff(git.NULL_TREE, create_patch=True)\n   227\t    for d in diff:\n   228\t        output.append(f\"\\n--- {d.a_path}\\n+++ {d.b_path}\\n\")\n   229\t        if d.diff is None:\n   230\t            continue\n   231\t        if isinstance(d.diff, bytes):\n   232\t            output.append(d.diff.decode('utf-8'))\n   233\t        else:\n   234\t            output.append(d.diff)\n   235\t    return \"\".join(output)\n   236\t\n   237\tdef validate_repo_path(repo_path: Path, allowed_repository: Path | None) -> None:\n   238\t    \"\"\"Validate that repo_path is within the allowed repository path.\"\"\"\n   239\t    if allowed_repository is None:\n   240\t        return  # No restriction configured\n   241\t\n   242\t    # Resolve both paths to handle symlinks and relative paths\n   243\t    try:\n   244\t        resolved_repo = repo_path.resolve()\n   245\t        resolved_allowed = allowed_repository.resolve()\n   246\t    except (OSError, RuntimeError):\n   247\t        raise ValueError(f\"Invalid path: {repo_path}\")\n   248\t\n   249\t    # Check if repo_path is the same as or a subdirectory of allowed_repository\n   250\t    try:\n   251\t        resolved_repo.relative_to(resolved_allowed)\n   252\t    except ValueError:\n   253\t        raise ValueError(\n   254\t            f\"Repository path '{repo_path}' is outside the allowed repository '{allowed_repository}'\"\n   255\t        )\n   256\t\n   257\t\n   258\tdef git_branch(repo: git.Repo, branch_type: str, contains: str | None = None, not_contains: str | None = None) -> str:\n   259\t    # Defense in depth: reject values starting with '-' to prevent flag injection\n   260\t    if contains and contains.startswith(\"-\"):\n   261\t        raise BadName(f\"Invalid contains value: '{contains}' - cannot start with '-'\")\n   262\t    if not_contains and not_contains.startswith(\"-\"):\n   263\t        raise BadName(f\"Invalid not_contains value: '{not_contains}' - cannot start with '-'\")\n   264\t\n   265\t    match contains:\n   266\t        case None:\n   267\t            contains_sha = (None,)\n   268\t        case _:\n   269\t            contains_sha = (\"--contains\", contains)\n   270\t\n   271\t    match not_contains:\n   272\t        case None:\n   273\t            not_contains_sha = (None,)\n   274\t        case _:\n   275\t            not_contains_sha = (\"--no-contains\", not_contains)\n   276\t\n   277\t    match branch_type:\n   278\t        case 'local':\n   279\t            b_type = None\n   280\t        case 'remote':\n   281\t            b_type = \"-r\"\n   282\t        case 'all':\n   283\t            b_type = \"-a\"\n   284\t        case _:\n   285\t            return f\"Invalid branch type: {branch_type}\"\n   286\t\n   287\t    # None value will be auto deleted by GitPython\n   288\t    branch_info = repo.git.branch(b_type, *contains_sha, *not_contains_sha)\n   289\t\n   290\t    return branch_info\n   291\t\n   292\t\n   293\tasync def serve(repository: Path | None) -> None:\n   294\t    logger = logging.getLogger(__name__)\n   295\t\n   296\t    if repository is not None:\n   297\t        try:\n   298\t            git.Repo(repository)\n   299\t            logger.info(f\"Using repository at {repository}\")\n   300\t        except git.InvalidGitRepositoryError:\n   301\t            logger.error(f\"{repository} is not a valid Git repository\")\n   302\t            return\n   303\t\n   304\t    server = Server(\"mcp-git\")\n   305\t\n   306\t    @server.list_tools()\n   307\t    async def list_tools() -> list[Tool]:\n   308\t        return [\n   309\t            Tool(\n   310\t                name=GitTools.STATUS,\n   311\t                description=\"Shows the working tree status\",\n   312\t                inputSchema=GitStatus.model_json_schema(),\n   313\t                annotations=ToolAnnotations(\n   314\t                    readOnlyHint=True,\n   315\t                    destructiveHint=False,\n   316\t                    idempotentHint=True,\n   317\t                    openWorldHint=False,\n   318\t                ),\n   319\t            ),\n   320\t            Tool(\n   321\t                name=GitTools.DIFF_UNSTAGED,\n   322\t                description=\"Shows changes in the working directory that are not yet staged\",\n   323\t                inputSchema=GitDiffUnstaged.model_json_schema(),\n   324\t                annotations=ToolAnnotations(\n   325\t                    readOnlyHint=True,\n   326\t                    destructiveHint=False,\n   327\t                    idempotentHint=True,\n   328\t                    openWorldHint=False,\n   329\t                ),\n   330\t            ),\n   331\t            Tool(\n   332\t                name=GitTools.DIFF_STAGED,\n   333\t                description=\"Shows changes that are staged for commit\",\n   334\t                inputSchema=GitDiffStaged.model_json_schema(),\n   335\t                annotations=ToolAnnotations(\n   336\t                    readOnlyHint=True,\n   337\t                    destructiveHint=False,\n   338\t                    idempotentHint=True,\n   339\t                    openWorldHint=False,\n   340\t                ),\n","exit_code":0,"status":"completed"}}
