{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/test_server.py | sed -n '261,520p'\"","aggregated_output":"   261\t\n   262\tdef test_validate_repo_path_exact_match(tmp_path: Path):\n   263\t    \"\"\"When repo_path exactly matches allowed_repository, validation should pass.\"\"\"\n   264\t    allowed = tmp_path / \"repo\"\n   265\t    allowed.mkdir()\n   266\t    validate_repo_path(allowed, allowed)  # Should not raise\n   267\t\n   268\t\n   269\tdef test_validate_repo_path_subdirectory(tmp_path: Path):\n   270\t    \"\"\"When repo_path is a subdirectory of allowed_repository, validation should pass.\"\"\"\n   271\t    allowed = tmp_path / \"repo\"\n   272\t    allowed.mkdir()\n   273\t    subdir = allowed / \"subdir\"\n   274\t    subdir.mkdir()\n   275\t    validate_repo_path(subdir, allowed)  # Should not raise\n   276\t\n   277\t\n   278\tdef test_validate_repo_path_outside_allowed(tmp_path: Path):\n   279\t    \"\"\"When repo_path is outside allowed_repository, validation should raise ValueError.\"\"\"\n   280\t    allowed = tmp_path / \"allowed_repo\"\n   281\t    allowed.mkdir()\n   282\t    outside = tmp_path / \"other_repo\"\n   283\t    outside.mkdir()\n   284\t\n   285\t    with pytest.raises(ValueError) as exc_info:\n   286\t        validate_repo_path(outside, allowed)\n   287\t    assert \"outside the allowed repository\" in str(exc_info.value)\n   288\t\n   289\t\n   290\tdef test_validate_repo_path_traversal_attempt(tmp_path: Path):\n   291\t    \"\"\"Path traversal attempts (../) should be caught and rejected.\"\"\"\n   292\t    allowed = tmp_path / \"allowed_repo\"\n   293\t    allowed.mkdir()\n   294\t    # Attempt to escape via ../\n   295\t    traversal_path = allowed / \"..\" / \"other_repo\"\n   296\t\n   297\t    with pytest.raises(ValueError) as exc_info:\n   298\t        validate_repo_path(traversal_path, allowed)\n   299\t    assert \"outside the allowed repository\" in str(exc_info.value)\n   300\t\n   301\t\n   302\tdef test_validate_repo_path_symlink_escape(tmp_path: Path):\n   303\t    \"\"\"Symlinks pointing outside allowed_repository should be rejected.\"\"\"\n   304\t    allowed = tmp_path / \"allowed_repo\"\n   305\t    allowed.mkdir()\n   306\t    outside = tmp_path / \"outside\"\n   307\t    outside.mkdir()\n   308\t\n   309\t    # Create a symlink inside allowed that points outside\n   310\t    symlink = allowed / \"escape_link\"\n   311\t    symlink.symlink_to(outside)\n   312\t\n   313\t    with pytest.raises(ValueError) as exc_info:\n   314\t        validate_repo_path(symlink, allowed)\n   315\t    assert \"outside the allowed repository\" in str(exc_info.value)\n   316\t# Tests for argument injection protection\n   317\t\n   318\tdef test_git_diff_rejects_flag_injection(test_repository):\n   319\t    \"\"\"git_diff should reject flags that could be used for argument injection.\"\"\"\n   320\t    with pytest.raises(BadName):\n   321\t        git_diff(test_repository, \"--output=/tmp/evil\")\n   322\t\n   323\t    with pytest.raises(BadName):\n   324\t        git_diff(test_repository, \"--help\")\n   325\t\n   326\t    with pytest.raises(BadName):\n   327\t        git_diff(test_repository, \"-p\")\n   328\t\n   329\t\n   330\tdef test_git_checkout_rejects_flag_injection(test_repository):\n   331\t    \"\"\"git_checkout should reject flags that could be used for argument injection.\"\"\"\n   332\t    with pytest.raises(BadName):\n   333\t        git_checkout(test_repository, \"--help\")\n   334\t\n   335\t    with pytest.raises(BadName):\n   336\t        git_checkout(test_repository, \"--orphan=evil\")\n   337\t\n   338\t    with pytest.raises(BadName):\n   339\t        git_checkout(test_repository, \"-f\")\n   340\t\n   341\t\n   342\tdef test_git_diff_allows_valid_refs(test_repository):\n   343\t    \"\"\"git_diff should work normally with valid git refs.\"\"\"\n   344\t    # Get the default branch name\n   345\t    default_branch = test_repository.active_branch.name\n   346\t\n   347\t    # Create a branch with a commit for diffing\n   348\t    test_repository.git.checkout(\"-b\", \"valid-diff-branch\")\n   349\t    file_path = Path(test_repository.working_dir) / \"test.txt\"\n   350\t    file_path.write_text(\"valid diff content\")\n   351\t    test_repository.index.add([\"test.txt\"])\n   352\t    test_repository.index.commit(\"valid diff commit\")\n   353\t\n   354\t    # Test with branch name\n   355\t    result = git_diff(test_repository, default_branch)\n   356\t    assert \"test.txt\" in result\n   357\t\n   358\t    # Test with HEAD~1\n   359\t    result = git_diff(test_repository, \"HEAD~1\")\n   360\t    assert \"test.txt\" in result\n   361\t\n   362\t    # Test with commit hash\n   363\t    commit_sha = test_repository.head.commit.hexsha\n   364\t    result = git_diff(test_repository, commit_sha)\n   365\t    assert result is not None\n   366\t\n   367\t\n   368\tdef test_git_checkout_allows_valid_branches(test_repository):\n   369\t    \"\"\"git_checkout should work normally with valid branch names.\"\"\"\n   370\t    # Get the default branch name\n   371\t    default_branch = test_repository.active_branch.name\n   372\t\n   373\t    # Create a branch to checkout\n   374\t    test_repository.git.branch(\"valid-checkout-branch\")\n   375\t\n   376\t    result = git_checkout(test_repository, \"valid-checkout-branch\")\n   377\t    assert \"Switched to branch 'valid-checkout-branch'\" in result\n   378\t    assert test_repository.active_branch.name == \"valid-checkout-branch\"\n   379\t\n   380\t    # Checkout back to default branch\n   381\t    result = git_checkout(test_repository, default_branch)\n   382\t    assert \"Switched to branch\" in result\n   383\t    assert test_repository.active_branch.name == default_branch\n   384\t\n   385\t\n   386\tdef test_git_diff_rejects_malicious_refs(test_repository):\n   387\t    \"\"\"git_diff should reject refs starting with '-' even if they exist.\n   388\t\n   389\t    This tests defense in depth against an attacker who creates malicious\n   390\t    refs via filesystem manipulation (e.g. using mcp-filesystem to write\n   391\t    to .git/refs/heads/--output=...).\n   392\t    \"\"\"\n   393\t    import os\n   394\t\n   395\t    # Manually create a malicious ref by writing directly to .git/refs\n   396\t    sha = test_repository.head.commit.hexsha\n   397\t    refs_dir = Path(test_repository.git_dir) / \"refs\" / \"heads\"\n   398\t    malicious_ref_path = refs_dir / \"--output=evil.txt\"\n   399\t    malicious_ref_path.write_text(sha)\n   400\t\n   401\t    # Even though the ref exists, it should be rejected\n   402\t    with pytest.raises(BadName):\n   403\t        git_diff(test_repository, \"--output=evil.txt\")\n   404\t\n   405\t    # Verify no file was created (the attack was blocked)\n   406\t    assert not os.path.exists(\"evil.txt\")\n   407\t\n   408\t    # Cleanup\n   409\t    malicious_ref_path.unlink()\n   410\t\n   411\t\n   412\tdef test_git_checkout_rejects_malicious_refs(test_repository):\n   413\t    \"\"\"git_checkout should reject refs starting with '-' even if they exist.\"\"\"\n   414\t    # Manually create a malicious ref\n   415\t    sha = test_repository.head.commit.hexsha\n   416\t    refs_dir = Path(test_repository.git_dir) / \"refs\" / \"heads\"\n   417\t    malicious_ref_path = refs_dir / \"--orphan=evil\"\n   418\t    malicious_ref_path.write_text(sha)\n   419\t\n   420\t    # Even though the ref exists, it should be rejected\n   421\t    with pytest.raises(BadName):\n   422\t        git_checkout(test_repository, \"--orphan=evil\")\n   423\t\n   424\t    # Cleanup\n   425\t    malicious_ref_path.unlink()\n   426\t\n   427\t\n   428\t# Tests for argument injection protection in git_show, git_create_branch,\n   429\t# git_log, and git_branch — matching the existing guards on git_diff and\n   430\t# git_checkout.\n   431\t\n   432\tdef test_git_show_rejects_flag_injection(test_repository):\n   433\t    \"\"\"git_show should reject revisions starting with '-'.\"\"\"\n   434\t    with pytest.raises(BadName):\n   435\t        git_show(test_repository, \"--output=/tmp/evil\")\n   436\t\n   437\t    with pytest.raises(BadName):\n   438\t        git_show(test_repository, \"-p\")\n   439\t\n   440\t\n   441\tdef test_git_show_rejects_malicious_refs(test_repository):\n   442\t    \"\"\"git_show should reject refs starting with '-' even if they exist.\"\"\"\n   443\t    sha = test_repository.head.commit.hexsha\n   444\t    refs_dir = Path(test_repository.git_dir) / \"refs\" / \"heads\"\n   445\t    malicious_ref_path = refs_dir / \"--format=evil\"\n   446\t    malicious_ref_path.write_text(sha)\n   447\t\n   448\t    with pytest.raises(BadName):\n   449\t        git_show(test_repository, \"--format=evil\")\n   450\t\n   451\t    malicious_ref_path.unlink()\n   452\t\n   453\t\n   454\tdef test_git_create_branch_rejects_flag_injection(test_repository):\n   455\t    \"\"\"git_create_branch should reject branch names starting with '-'.\"\"\"\n   456\t    with pytest.raises(BadName):\n   457\t        git_create_branch(test_repository, \"--track=evil\")\n   458\t\n   459\t    with pytest.raises(BadName):\n   460\t        git_create_branch(test_repository, \"-f\")\n   461\t\n   462\t\n   463\tdef test_git_create_branch_rejects_base_branch_flag_injection(test_repository):\n   464\t    \"\"\"git_create_branch should reject base branch names starting with '-'.\"\"\"\n   465\t    with pytest.raises(BadName):\n   466\t        git_create_branch(test_repository, \"new-branch\", \"--track=evil\")\n   467\t\n   468\t\n   469\tdef test_git_log_rejects_timestamp_flag_injection(test_repository):\n   470\t    \"\"\"git_log should reject timestamps starting with '-'.\"\"\"\n   471\t    with pytest.raises(ValueError):\n   472\t        git_log(test_repository, start_timestamp=\"--exec=evil\")\n   473\t\n   474\t    with pytest.raises(ValueError):\n   475\t        git_log(test_repository, end_timestamp=\"--exec=evil\")\n   476\t\n   477\t\n   478\tdef test_git_branch_rejects_contains_flag_injection(test_repository):\n   479\t    \"\"\"git_branch should reject contains/not_contains values starting with '-'.\"\"\"\n   480\t    with pytest.raises(BadName):\n   481\t        git_branch(test_repository, \"local\", contains=\"--exec=evil\")\n   482\t\n   483\t    with pytest.raises(BadName):\n   484\t        git_branch(test_repository, \"local\", not_contains=\"--exec=evil\")\n","exit_code":0,"status":"completed"}}
