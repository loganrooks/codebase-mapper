{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "findings_logged",
    "challenge_ids",
    "factual_spot_checks",
    "interpretive_challenges_attempted",
    "challenges"
  ],
  "properties": {
    "body": {
      "type": "string",
      "minLength": 1
    },
    "findings_logged": {
      "type": "integer",
      "minimum": 0
    },
    "challenge_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^chl-[0-9]{5,}$"
      }
    },
    "factual_spot_checks": {
      "type": "integer",
      "minimum": 0
    },
    "interpretive_challenges_attempted": {
      "type": "integer",
      "minimum": 0
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "competing_reading",
          "competing_evidence",
          "interpretive_axis",
          "relation_to_original",
          "rationale"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "competing_reading": {
            "type": "string",
            "minLength": 20
          },
          "competing_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[^`:',#@\\s]+:\\d+(?:-\\d+)?@[0-9a-f]{7,40}$"
            }
          },
          "interpretive_axis": {
            "enum": [
              "centrality",
              "scope",
              "salience",
              "classification",
              "framing",
              "completeness",
              "other"
            ]
          },
          "relation_to_original": {
            "enum": [
              "complementary",
              "competing",
              "reframing",
              "scope_dispute"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
