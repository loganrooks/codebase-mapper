{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbm.local/schemas/approval-plan.schema.json",
  "title": "Approval Plan",
  "description": "Deep-mode manual approval UX artifact for command execution and refinement escalation.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "produced_at",
    "produced_by",
    "source_sha",
    "inputs",
    "status",
    "approval_items",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.2" },
    "artifact_type": { "const": "approval_plan" },
    "run_id": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string", "format": "date-time" },
    "produced_by": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "status": { "enum": ["draft", "validated", "reviewed", "retired"] },
    "approval_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "approval_id",
          "source_artifact",
          "approval_kind",
          "action",
          "risk_level",
          "approval_status",
          "safety_envelope",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "approval_id": { "type": "string", "pattern": "^apv-[0-9]{4}$" },
          "source_artifact": { "type": "string" },
          "source_ref": { "type": "string" },
          "approval_kind": { "enum": ["command_execution", "manual_review", "refinement_escalation"] },
          "action": { "type": "string", "minLength": 1 },
          "risk_level": { "enum": ["low", "medium", "high"] },
          "approval_status": { "enum": ["pending", "approved", "rejected", "not_required"] },
          "safety_envelope": {
            "type": "object",
            "required": ["requires_network", "requires_install", "mutates_filesystem", "max_duration_seconds"],
            "additionalProperties": false,
            "properties": {
              "requires_network": { "type": "boolean" },
              "requires_install": { "type": "boolean" },
              "mutates_filesystem": { "type": "boolean" },
              "max_duration_seconds": { "type": "integer", "minimum": 1 },
              "declared_output_paths": { "type": "array", "items": { "type": "string" } }
            }
          },
          "rationale": { "type": "string", "minLength": 20 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 20 }
  }
}
