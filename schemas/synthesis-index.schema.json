{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbm.local/schemas/synthesis-index.schema.json",
  "title": "Synthesis Index",
  "description": "Standard-mode index connecting authority, dependency, verification, and surface artifacts for downstream planning.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "produced_at",
    "produced_by",
    "source_sha",
    "inputs",
    "status",
    "coverage",
    "staleness",
    "summary",
    "claim_counts",
    "contestation",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.2" },
    "artifact_type": { "const": "synthesis_index" },
    "run_id": { "type": "string" },
    "produced_at": { "type": "string", "format": "date-time" },
    "produced_by": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "status": { "enum": ["draft", "validated", "reviewed", "retired"] },
    "coverage": { "$ref": "https://cbm.local/schemas/codebase-map.schema.json#/$defs/coverage" },
    "staleness": { "$ref": "https://cbm.local/schemas/codebase-map.schema.json#/$defs/staleness" },
    "summary": { "type": "string", "minLength": 20 },
    "claim_counts": {
      "type": "object",
      "required": ["authorities", "dependencies", "verification_gates"],
      "additionalProperties": false,
      "properties": {
        "authorities": { "type": "integer", "minimum": 0 },
        "dependencies": { "type": "integer", "minimum": 0 },
        "verification_gates": { "type": "integer", "minimum": 0 }
      }
    },
    "contestation": {
      "type": "object",
      "required": ["open_challenges", "challenged_claims"],
      "additionalProperties": false,
      "properties": {
        "open_challenges": { "type": "integer", "minimum": 0 },
        "challenged_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_path", "claim_id", "challenge_ids"],
            "properties": {
              "artifact_path": { "type": "string" },
              "claim_id": { "type": "string" },
              "challenge_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^chl-[0-9]{5,}$" }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "artifact_type"],
        "properties": {
          "path": { "type": "string" },
          "artifact_type": { "type": "string" }
        }
      }
    }
  }
}
