{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "producer-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "backend", "producers"],
  "properties": {
    "schema_version": { "const": "1.2" },
    "artifact_type": { "const": "producer_registry" },
    "backend": { "enum": ["deterministic", "external", "codex-cli"] },
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "producer_id", "backend", "execution_contract"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1 },
          "producer_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
          },
          "backend": { "enum": ["deterministic", "external", "codex-cli"] },
          "execution_contract": {
            "enum": ["deterministic_baseline", "dev_fixture", "external_agent"]
          }
        }
      }
    }
  }
}
