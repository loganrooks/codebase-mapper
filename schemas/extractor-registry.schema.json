{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbm.local/schemas/extractor-registry.schema.json",
  "title": "Extractor Registry",
  "description": "Catalogue of deterministic extractors used by the system. Edges and authorities cite extractors by id; the Skeptic looks up known blind spots when reviewing claims that depend on a given extractor.",
  "type": "object",
  "required": ["schema_version", "extractors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.2" },
    "extractors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/extractor" }
    },
    "project_pack_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_type", "pack_id", "extractor_annotations", "known_blind_spots"],
        "additionalProperties": false,
        "properties": {
          "project_type": { "type": "string" },
          "pack_id": { "type": "string" },
          "extractor_annotations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "known_blind_spots": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "extractor": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version",
        "language_or_format",
        "deterministic",
        "produces_evidence_kinds",
        "known_blind_spots"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ext-[a-z0-9-]+(-v[0-9]+)?$",
          "description": "Stable id, e.g. 'ext-treesitter-python-v1'."
        },
        "kind": {
          "enum": [
            "ast",
            "language_server",
            "regex",
            "manifest_parser",
            "build_graph",
            "schema_parser",
            "test_discovery",
            "ci_parser",
            "import_graph",
            "other"
          ]
        },
        "version": { "type": "string" },
        "language_or_format": {
          "type": "string",
          "description": "Language or file format the extractor handles, e.g. 'python', 'typescript', 'package.json', 'github_actions_yaml'."
        },
        "deterministic": {
          "type": "boolean",
          "description": "True if same inputs always produce same outputs. False extractors must be flagged loudly to the Skeptic."
        },
        "produces_evidence_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "static_structure",
              "static_relation",
              "command_output",
              "runtime_trace",
              "maintainer_statement",
              "external_doc"
            ]
          },
          "minItems": 1,
          "description": "What evidence_kinds this extractor's output supports. Used by the Skeptic to validate evidence_kinds claims on edges that cite this extractor."
        },
        "known_blind_spots": {
          "type": "array",
          "minItems": 1,
          "description": "Things this extractor does not detect. Required and non-empty: every extractor has blind spots; pretending otherwise is the failure mode this field exists to prevent.",
          "items": {
            "type": "object",
            "required": ["description", "category"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 10
              },
              "category": {
                "enum": [
                  "dynamic_dispatch",
                  "metaprogramming",
                  "reflection",
                  "runtime_loaded_plugins",
                  "conditional_execution",
                  "external_systems",
                  "generated_code",
                  "macro_expansion",
                  "string_eval",
                  "configuration_dependent",
                  "version_dependent",
                  "other"
                ]
              },
              "example": {
                "type": "string",
                "description": "Concrete example of what is missed."
              }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
